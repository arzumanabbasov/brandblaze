# BrandBlaze API
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=us-west-004
# Either a custom public domain or the numeric download host shard.
B2_PUBLIC_BASE_URL=
B2_DOWNLOAD_HOST_ID=005
B2_SOURCE_URL_TTL=3600
B2_OUTPUT_URL_TTL=3600

# Claude is the vision analyst and creative director.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# GMI Cloud is the only image-generation provider.
GMI_API_KEY=
GMI_IMAGE_MODEL=seedream-5.0-lite
GMI_IMAGE_SIZE=2048x2048
GMI_OUTPUT_FORMAT=png

GENBLAZE_FALLBACK_MODELS=
GENBLAZE_CONCURRENCY=3
GENBLAZE_TIMEOUT=300
MAX_VARIANTS_PER_RUN=12
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Browser app
NEXT_PUBLIC_API_URL=http://localhost:8000
